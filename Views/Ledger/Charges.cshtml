@model List<Lab3Accounting.Models.Charge>
@{ ViewData["Title"] = "Начисления"; var apartment = Context.Request.Query["apartment"].ToString(); }
<div class="page-tools"><form method="get" class="filter-form"><input name="apartment" value="@apartment" type="number" min="1" placeholder="Квартира" /><button class="button outline">Фильтр</button><a class="button ghost" asp-action="Charges">Сбросить</a></form><span class="count-badge">@Model.Count операций</span></div>
<div class="split-grid ledger-grid"><section class="panel form-panel"><div class="panel-head"><div><span class="eyebrow">Новая запись</span><h3>Добавить начисление</h3></div></div><form asp-action="SaveCharge" method="post" class="form-stack">@Html.AntiForgeryToken()<label>Квартира<input name="ApartmentNumber" type="number" min="1" required /></label><label>Период<input name="Period" type="date" required /></label><label>Сумма<input name="Amount" type="number" min="0.01" step="0.01" required /></label><label>Описание<input name="Description" value="Начисление по квартире" maxlength="200" /></label><button class="button primary">Сохранить</button><div class="formula">Для квартиры и периода повтор такой же суммы блокируется.</div></form></section>
<section class="panel table-panel"><div class="panel-head"><div><span class="eyebrow">Журнал</span><h3>Начисления</h3></div></div><div class="table-wrap"><table><thead><tr><th>Кв.</th><th>Период</th><th>Сумма</th><th>Описание</th><th>Создано</th><th>Изменено</th><th></th></tr></thead><tbody>@foreach(var row in Model){<tr><td><b>@row.ApartmentNumber</b></td><td>@row.Period.ToString("MM.yyyy")</td><td>@row.Amount.ToString("N2")</td><td>@row.Description</td><td>@row.CreatedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")</td><td>@row.UpdatedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")</td><td><form asp-action="Delete" asp-route-table="charges" asp-route-id="@row.Id" method="post" onsubmit="return confirm('Удалить начисление?');">@Html.AntiForgeryToken()<button class="icon-button">×</button></form></td></tr>}</tbody></table></div></section></div>
