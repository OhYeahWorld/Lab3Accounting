@model List<Lab3Accounting.Models.Payment>
@{ ViewData["Title"] = "Платежи"; var apartment = Context.Request.Query["apartment"].ToString(); }
<div class="page-tools"><form method="get" class="filter-form"><input name="apartment" value="@apartment" type="number" min="1" placeholder="Квартира" /><button class="button outline">Фильтр</button><a class="button ghost" asp-action="Payments">Сбросить</a></form><span class="count-badge">@Model.Count операций</span></div>
<div class="split-grid ledger-grid"><section class="panel form-panel"><div class="panel-head"><div><span class="eyebrow">Новая запись</span><h3>Добавить платеж</h3></div></div><form asp-action="SavePayment" method="post" class="form-stack">@Html.AntiForgeryToken()<label>Квартира<input name="ApartmentNumber" type="number" min="1" required /></label><label>Период<input name="Period" type="date" required /></label><label>Дата платежа<input name="PaymentDate" type="date" required /></label><label>Сумма<input name="Amount" type="number" min="0.01" step="0.01" required /></label><label>Номер / ссылка<input name="PaymentReference" maxlength="100" placeholder="необязательно" /></label><button class="button primary">Сохранить</button><div class="formula">Одинаковый платеж повторно записать нельзя.</div></form></section>
<section class="panel table-panel"><div class="panel-head"><div><span class="eyebrow">Журнал</span><h3>Платежи</h3></div></div><div class="table-wrap"><table><thead><tr><th>Кв.</th><th>Период</th><th>Дата</th><th>Сумма</th><th>Ссылка</th><th>Создано</th><th>Изменено</th><th></th></tr></thead><tbody>@foreach(var row in Model){<tr><td><b>@row.ApartmentNumber</b></td><td>@row.Period.ToString("MM.yyyy")</td><td>@row.PaymentDate.ToString("dd.MM.yyyy")</td><td>@row.Amount.ToString("N2")</td><td>@(row.PaymentReference ?? "—")</td><td>@row.CreatedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")</td><td>@row.UpdatedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")</td><td><form asp-action="Delete" asp-route-table="payments" asp-route-id="@row.Id" method="post" onsubmit="return confirm('Удалить платеж?');">@Html.AntiForgeryToken()<button class="icon-button">×</button></form></td></tr>}</tbody></table></div></section></div>
