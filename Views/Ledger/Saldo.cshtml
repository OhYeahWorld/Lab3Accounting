@model List<Lab3Accounting.Models.Saldo>
@{ ViewData["Title"] = "Сальдо"; var apartment = Context.Request.Query["apartment"].ToString(); }
<div class="page-tools"><form method="get" class="filter-form"><input name="apartment" value="@apartment" type="number" min="1" placeholder="Квартира" /><button class="button outline">Фильтр</button><a class="button ghost" asp-action="Saldo">Сбросить</a></form><span class="count-badge">@Model.Count записей</span></div>
<div class="split-grid ledger-grid">
<section class="panel form-panel"><div class="panel-head"><div><span class="eyebrow">Новая запись</span><h3>Добавить сальдо</h3></div></div>
<form asp-action="SaveSaldo" method="post" class="form-stack">@Html.AntiForgeryToken()<label>Квартира<input name="ApartmentNumber" type="number" min="1" required /></label><label>Период<input name="Period" type="date" required /></label><label>Входящее сальдо<input name="OpeningBalance" type="number" step="0.01" required /></label><button class="button primary">Сохранить</button><div class="formula">Исходящее считается автоматически:<br><b>входящее + начисления − платежи</b></div></form></section>
<section class="panel table-panel"><div class="panel-head"><div><span class="eyebrow">Журнал</span><h3>История сальдо</h3></div></div><div class="table-wrap"><table><thead><tr><th>Кв.</th><th>Период</th><th>Входящее</th><th>Исходящее</th><th>Создано</th><th>Изменено</th><th></th></tr></thead><tbody>@foreach (var row in Model) {<tr><td><b>@row.ApartmentNumber</b></td><td>@row.Period.ToString("MM.yyyy")</td><td>@row.OpeningBalance.ToString("N2")</td><td>@row.ClosingBalance.ToString("N2")</td><td>@row.CreatedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")</td><td>@row.UpdatedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")</td><td><form asp-action="Delete" asp-route-table="saldo" asp-route-id="@row.Id" method="post" onsubmit="return confirm('Удалить запись?');">@Html.AntiForgeryToken()<button class="icon-button">×</button></form></td></tr>}</tbody></table></div></section>
</div>
