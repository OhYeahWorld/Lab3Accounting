@model List<Lab3Accounting.ViewModels.ApartmentRow>
@{ ViewData["Title"] = "По квартире"; var apartment=(int)ViewBag.Apartment; var year=(int)ViewBag.Year; var apartments=(List<int>)ViewBag.Apartments; }
<div class="report-head"><div><span class="eyebrow">Хранимая функция · sp_apartment_statement</span><h2>Оборот по квартире №@apartment</h2><p>Месячная лента показывает входящее сальдо, начисления, платежи и исходящее сальдо.</p></div><form method="get" class="selector-row"><select name="apartment">@foreach(var a in apartments){<option value="@a" selected="@(a == apartment ? "selected" : null)">Квартира @a</option>}</select><input name="year" value="@year" type="number"/><button class="button primary">Открыть</button></form></div>
<section class="panel report-card"><div class="apartment-summary"><div><small>Начало года</small><b>@(Model.FirstOrDefault()?.OpeningBalance?.ToString("N2") ?? "—")</b></div><div><small>Начислено</small><b>@Model.Sum(x=>x.ChargesTotal).ToString("N2")</b></div><div><small>Оплачено</small><b>@Model.Sum(x=>x.PaymentsTotal).ToString("N2")</b></div><div><small>Последнее сальдо</small><b>@(Model.LastOrDefault()?.ClosingBalance?.ToString("N2") ?? "—")</b></div></div></section>
<section class="timeline">@foreach(var row in Model){<article class="month-card"><div class="month-label"><b>@row.MonthStart.ToString("MM.yyyy")</b><span>@row.MonthStart.ToString("MMMM", System.Globalization.CultureInfo.GetCultureInfo("ru-RU"))</span></div><div class="month-values"><div><small>Входящее</small><strong>@row.CalcOpeningBalance.ToString("N2")</strong></div><div><small>Начислено</small><strong>@row.ChargesTotal.ToString("N2")</strong></div><div><small>Оплачено</small><strong>@row.PaymentsTotal.ToString("N2")</strong></div><div><small>Исходящее</small><strong class="@(row.CalcClosingBalance<0 ? "negative" : "")">@row.CalcClosingBalance.ToString("N2")</strong></div></div><div class="action-time">@(row.ActionAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") ?? "нет действий")</div></article>}</section>
