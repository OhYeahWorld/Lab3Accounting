@model List<Lab3Accounting.ViewModels.DebtorRow>
@{ ViewData["Title"] = "Должники"; var asOf=(DateOnly)ViewBag.AsOf; }
<div class="report-head"><div><span class="eyebrow">Хранимая функция · sp_debtors_summary</span><h2>Должники по категориям</h2><p>Состояние на @asOf.ToString("dd.MM.yyyy"). Категория рассчитывается относительно начисления последнего полного месяца.</p></div><form method="get" class="selector-row"><input name="asOf" value="@asOf.ToString("yyyy-MM-dd")" type="date"/><button class="button primary">Пересчитать</button></form></div>
<section class="panel report-card"><div class="debt-counters"><div><b>@Model.Count</b><span>лицевых счетов с положительным долгом</span></div><div><b>@Model.Sum(x=>x.Balance).ToString("N2")</b><span>руб. текущей задолженности</span></div></div></section>
<div class="table-wrap debtor-table"><table><thead><tr><th>Квартира</th><th>Начислено за последний полный месяц</th><th>Сальдо</th><th>1 месяц</th><th>2 месяца</th><th>3 месяца</th><th>Свыше 3</th><th>Расчет</th><th>Последнее действие</th></tr></thead><tbody>@foreach(var row in Model){<tr><td><b>№ @row.ApartmentNumber</b></td><td>@row.LastMonthCharge.ToString("N2")</td><td class="debt">@row.Balance.ToString("N2")</td><td>@(row.OneMonth?.ToString("N2") ?? "")</td><td>@(row.TwoMonths?.ToString("N2") ?? "")</td><td>@(row.ThreeMonths?.ToString("N2") ?? "")</td><td>@(row.OverThreeMonths?.ToString("N2") ?? "")</td><td>@row.DebtMonths.ToString("0") мес. · @row.Category</td><td>@(row.ActionAt?.ToLocalTime().ToString("dd.MM.yy HH:mm:ss") ?? "—")</td></tr>}</tbody></table></div>
