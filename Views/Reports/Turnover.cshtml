@model List<Lab3Accounting.ViewModels.TurnoverRow>
@{ ViewData["Title"] = "Оборотная ведомость"; var year = Context.Request.Query["year"].ToString(); if(string.IsNullOrWhiteSpace(year)) year="2017"; var months = new[]{"Янв","Фев","Мар","Апр","Май","Июн","Июл","Авг","Сен","Окт","Ноя","Дек"}; var apartments=Model.Select(x=>x.ApartmentNumber).Distinct().OrderBy(x=>x); }
<div class="report-head"><div><span class="eyebrow">Хранимая функция · sp_turnover_statement</span><h2>Оборотная ведомость за @year год</h2><p>В каждой месячной ячейке рассчитываются входящее и исходящее сальдо, а также начисления и платежи этого месяца.</p></div><form class="filter-form" method="get"><input name="year" value="@year" type="number" min="2000" max="2100"/><button class="button primary">Показать</button></form></div>
<div class="report-shell"><div class="table-wrap"><table class="turnover-table"><thead><tr><th class="sticky-col">Квартира</th>@foreach(var m in months){<th>@m</th>}<th>Год</th></tr></thead><tbody>
@foreach(var apt in apartments){var aptRows=Model.Where(x=>x.ApartmentNumber==apt).OrderBy(x=>x.MonthNo).ToList();<tr><td class="sticky-col apartment-cell"><b>№ @apt</b><small>вход.: @((aptRows.FirstOrDefault(x=>x.OpeningBalance!=null)?.OpeningBalance ?? aptRows.FirstOrDefault()?.CalcOpeningBalance)?.ToString("N2") ?? "—")</small></td>@for(var i=1;i<=12;i++){var x=aptRows.FirstOrDefault(r=>r.MonthNo==i);<td class="turn-cell">@if(x is null){<span class="muted">—</span>}else{<span class="balance-in"><em>Вх.</em>@x.CalcOpeningBalance.ToString("N2")</span><span><em>Нач.</em>@x.ChargesTotal.ToString("N2")</span><span><em>Пл.</em>@x.PaymentsTotal.ToString("N2")</span><span class="balance-out @(x.CalcClosingBalance < 0 ? "negative" : "")"><em>Исх.</em>@x.CalcClosingBalance.ToString("N2")</span><small class="cell-time">@(x.ActionAt?.ToLocalTime().ToString("dd.MM HH:mm") ?? "")</small>}</td>}<td class="year-cell">@(aptRows.LastOrDefault()?.CalcClosingBalance.ToString("N2") ?? "—")</td></tr>}
</tbody></table></div></div>
<div class="legend"><span><i class="dot balance"></i> входящее (расчет)</span><span><i class="dot charge"></i> начисление</span><span><i class="dot payment"></i> платеж</span><span><i class="dot balance"></i> исходящее (расчет)</span><span class="time-note">Входящее = сальдо начала года + накопленные (начисления − платежи) предыдущих месяцев; исходящее = входящее + начисления − платежи текущего месяца. Время внизу ячейки — последнее действие в этом месяце.</span></div>
